NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# O backend usa a chave server-only. Nunca use NEXT_PUBLIC_* aqui.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma and runtime database connection.
DATABASE_URL=postgresql://postgres:password@database-host:5432/postgres
# Upstash TCP/TLS URL (copy from Upstash > Connect > Node.js). BullMQ/ioredis
# requires the rediss:// connection string, not the REST URL/token pair.
REDIS_URL=rediss://default:your-password@your-database.upstash.io:6379
PUBLIC_API_URL=https://your-ngrok-domain.ngrok-free.app
PUBLIC_FRONT_URL=https://your-frontend-ngrok-domain.ngrok-free.app

# Shadow mode da V3 de ingestão. Quando true, o worker tenta o parser
# configurável via URL antes de seguir o fluxo legado.
DOCUMENT_INGESTION_V3_ENABLED=false
DOCUMENT_PARSER_BASE_URL=http://127.0.0.1:8080
DOCUMENT_PARSER_REQUEST_TIMEOUT_MS=600000
DOCUMENT_PARSER_MAX_ATTEMPTS=1

# Modelo global usado quando um agente não define um modelo específico.
OPENROUTER_QUESTION_MODEL=google/gemini-2.5-flash
AI_REASONING_EFFORT=low
CHAT_AI_MODEL=qwen/qwen3-30b-a3b
CHAT_AI_MAX_TOKENS=600
CHAT_AI_TEMPERATURE=0.2
CHAT_AI_TIMEOUT_MS=30000

# Usado somente pelo worker para gerar embeddings dos chunks.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_STRUCTURED_TIMEOUT_MS=30000
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=64

# Agente de extração inicial de questões.
QUESTION_EXTRACTION_MODEL=google/gemini-2.5-flash
QUESTION_EXTRACTION_MAX_TOKENS=4000
QUESTION_EXTRACTION_TEMPERATURE=0.1
QUESTION_SOURCE_RECONSTRUCTION_MODEL=google/gemini-2.5-flash
QUESTION_SOURCE_RECONSTRUCTION_MAX_TOKENS=1200
QUESTION_SOURCE_RECONSTRUCTION_TEMPERATURE=0.1

# Agente de categorização da questão.
QUESTION_CATEGORIZE_MODEL=google/gemini-2.5-flash
QUESTION_CATEGORIZE_MAX_TOKENS=256
QUESTION_CATEGORIZE_TEMPERATURE=0.1

# Agente de definição e perfil dos tópicos.
TOPIC_PROFILE_MODEL=google/gemini-2.5-flash
TOPIC_PROFILE_MAX_TOKENS=900
TOPIC_PROFILE_TEMPERATURE=0.2

# Agente de conclusão do enunciado.
QUESTION_COMPLETION_MODEL=google/gemini-2.5-flash
QUESTION_COMPLETION_MAX_TOKENS=700
QUESTION_COMPLETION_TEMPERATURE=0.5

# Agente de geração/correção das 5 alternativas.
QUESTION_ALTERNATIVES_MODEL=google/gemini-2.5-flash
QUESTION_ALTERNATIVES_MAX_TOKENS=1200
QUESTION_ALTERNATIVES_TEMPERATURE=0.6

# Agente de identificação do gabarito.
QUESTION_ANSWER_MODEL=google/gemini-2.5-flash
QUESTION_ANSWER_MAX_TOKENS=400
QUESTION_ANSWER_TEMPERATURE=0.2

# Agente de geração da explicação pedagógica.
QUESTION_EXPLANATION_MODEL=google/gemini-2.5-flash
QUESTION_EXPLANATION_MAX_TOKENS=2000
QUESTION_EXPLANATION_TEMPERATURE=0.4

# Agente de revisão semântica final da questão.
QUESTION_QUALITY_REVIEW_MODEL=google/gemini-2.5-flash
QUESTION_QUALITY_REVIEW_MAX_TOKENS=1200
QUESTION_QUALITY_REVIEW_TEMPERATURE=0.1

# Agente de classificação dos blocos estruturais do documento.
DOCUMENT_BLOCK_TOPIC_CLASSIFICATION_MODEL=google/gemini-2.5-flash
DOCUMENT_BLOCK_TOPIC_CLASSIFICATION_MAX_TOKENS=4000
DOCUMENT_BLOCK_TOPIC_CLASSIFICATION_TEMPERATURE=0.1
BLOCK_TOPIC_CLASSIFICATION_BATCH_SIZE=8

# Fallback e controles de execução dos agentes.
QUESTION_COMPLETION_FALLBACK_MODEL=
ENABLE_PAID_STRUCTURED_FALLBACK=true
QUESTION_CANDIDATE_CONCURRENCY=3

# Geração de flashcards: modelo textual principal, fallback e limite seguro.
FLASHCARD_GENERATION_MODEL=openai/gpt-5-mini
FLASHCARD_GENERATION_FALLBACK_MODEL=google/gemini-3.7-flash
FLASHCARD_GENERATION_CONCURRENCY=3

# CORS: informe as origens exatas, separadas por virgula.
CORS_ORIGINS=https://meumonitor.ai,https://www.meumonitor.ai,https://front-meumonitor.vercel.app,https://front-meumonitor-git-main-joao-victor-asevedos-projects.vercel.app,https://meumonitoria.com.br,http://localhost:3000

# Pagamentos: a Fase 2 usa o checkout hospedado do Asaas.
# Mantenha SIMULATED até o adapter e os webhooks estarem habilitados no rollout.
PAYMENTS_PROVIDER=SIMULATED
ASAAS_ENV=sandbox
ASAAS_API_KEY=your-asaas-sandbox-api-key
# Base64 de exatamente 32 bytes; mantenha somente no backend/secret manager.
ASAAS_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# O painel do sandbox é separado do painel de produção.
ASAAS_DASHBOARD_URL=https://sandbox.asaas.com/login
ASAAS_WEBHOOK_AUTH_TOKEN=replace-with-a-random-token-of-at-least-32-chars
ASAAS_WEBHOOK_URL=https://your-ngrok-domain.ngrok-free.app/api/v1/payments/webhooks/asaas
ASAAS_WEBHOOK_EMAIL=your-main-asaas-email@example.com
ASAAS_WEBHOOK_ID=
PAYMENTS_RETURN_BASE_URL=https://meumonitor.ai
ASAAS_HTTP_TIMEOUT_MS=10000
PAYMENTS_SIMULATION_ENABLED=false
PAYMENTS_TEST_PRICE_CENTS=1990
