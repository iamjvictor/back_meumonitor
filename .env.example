NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# O backend usa a chave server-only. Nunca use NEXT_PUBLIC_* aqui.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma and runtime database connection.
DATABASE_URL=postgresql://postgres:password@database-host:5432/postgres
REDIS_URL=redis://localhost:6379

# Usado somente pelo worker para gerar embeddings dos chunks.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=64
OPENROUTER_QUESTION_MODEL=openai/gpt-4o-mini

# Extracao inicial de candidatas de questao a partir dos chunks.
QUESTION_EXTRACTION_MODEL=openai/gpt-4o-mini
QUESTION_EXTRACTION_MAX_TOKENS=4000
QUESTION_EXTRACTION_TEMPERATURE=0.1

# Modelos dos agentes de conclusao de questoes.
QUESTION_CATEGORIZE_MODEL=openai/gpt-4.1-nano
QUESTION_CATEGORIZE_MAX_TOKENS=256
QUESTION_CATEGORIZE_TEMPERATURE=0.1
TOPIC_PROFILE_MODEL=openai/gpt-4.1-nano
TOPIC_PROFILE_MAX_TOKENS=700
TOPIC_PROFILE_TEMPERATURE=0.2
QUESTION_COMPLETION_MODEL=z-ai/glm-5.2:free
QUESTION_COMPLETION_MAX_TOKENS=700
QUESTION_COMPLETION_TEMPERATURE=0.5
QUESTION_ALTERNATIVES_MODEL=meta-llama/llama-3.1-70b-instruct
QUESTION_ALTERNATIVES_MAX_TOKENS=500
QUESTION_ALTERNATIVES_TEMPERATURE=0.6
QUESTION_ANSWER_MODEL=openai/gpt-4.1-mini
QUESTION_ANSWER_MAX_TOKENS=400
QUESTION_ANSWER_TEMPERATURE=0.2
QUESTION_EXPLANATION_MODEL=z-ai/glm-5.2:free
QUESTION_EXPLANATION_MAX_TOKENS=350
QUESTION_EXPLANATION_TEMPERATURE=0.4
QUESTION_COMPLETION_FALLBACK_MODEL=
ENABLE_PAID_STRUCTURED_FALLBACK=false

# Classificacao de topicos dos blocos estruturais do documento.
DOCUMENT_BLOCK_TOPIC_CLASSIFICATION_MODEL=openai/gpt-4.1-nano
DOCUMENT_BLOCK_TOPIC_CLASSIFICATION_MAX_TOKENS=4000
DOCUMENT_BLOCK_TOPIC_CLASSIFICATION_TEMPERATURE=0.1
BLOCK_TOPIC_CLASSIFICATION_BATCH_SIZE=8
QUESTION_CANDIDATE_CONCURRENCY=3

# CORS: informe as origens exatas, separadas por virgula.
CORS_ORIGINS=https://meumonitor.ai,https://www.meumonitor.ai,http://localhost:3000
