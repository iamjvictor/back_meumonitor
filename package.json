{
  "name": "meumonitor-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:documents": "node --import tsx ../test/scripts/chunks/test-document-chunking.ts",
    "test:document-chunking-path-contract": "node --import tsx ../test/scripts/chunks/test-document-chunking-path-contract.ts",
    "test:document-parser-contract": "node --import tsx src/scripts/test-document-parser-contract.ts",
    "test:document-parser-layout-contract": "node --import tsx src/scripts/test-document-parser-layout-contract.ts",
    "test:document-parser-persistence-contract": "node --import tsx src/scripts/test-document-parser-persistence-contract.ts",
    "test:document-parser-storage-contract": "node --import tsx src/scripts/test-document-parser-storage-contract.ts",
    "test:document-parser-unit": "node --import tsx --test src/worker/services/document-parser/__tests__/layout-document-normalizer.test.ts src/worker/services/document-parser/__tests__/mineru-parser.adapter.test.ts",
    "test:chat": "node --import tsx --test src/modules/chat/__tests__/chat.module.test.ts src/modules/chat/models/__tests__/chat.model.test.ts src/modules/chat/services/__tests__/chat-authorization.service.test.ts src/modules/chat/services/__tests__/chat-question-context.service.test.ts src/modules/chat/services/__tests__/chat.service.test.ts src/modules/chat/services/__tests__/chat-prompt.builder.test.ts src/modules/chat/providers/__tests__/openrouter-chat.gateway.test.ts src/modules/chat/repositories/__tests__/prisma-chat-access.repository.test.ts src/modules/chat/repositories/__tests__/redis-chat-history.repository.test.ts src/modules/chat/rag/services/__tests__/chat-query.builder.test.ts src/modules/chat/rag/services/__tests__/chat-query.latency.test.ts src/modules/chat/rag/services/__tests__/chat-retrieval-strategy.service.test.ts src/modules/chat/rag/services/__tests__/chat-rag.service.test.ts src/modules/chat/rag/providers/__tests__/knowledge-retrieval-chat.provider.test.ts src/modules/chat/rag/providers/__tests__/prisma-question-evidence.provider.test.ts src/modules/chat/rag/providers/__tests__/prisma-flashcard-evidence.provider.test.ts src/modules/chat/rag/repositories/__tests__/redis-chat-evidence.repository.test.ts src/modules/chat/rag/services/__tests__/question-evidence.context.test.ts src/modules/chat/rag/services/__tests__/flashcard-evidence.context.test.ts src/modules/chat/rag/services/__tests__/chat-context.assembler.test.ts src/modules/chat/rag/services/__tests__/chat-context-resolver.service.test.ts src/modules/chat/rag/__tests__/chat-rag.observability.test.ts src/modules/chat/rag/services/__tests__/question-evidence-sufficiency.test.ts src/modules/chat/rag/__tests__/question-fast-path.performance.test.ts",
    "test:flashcard-generation": "node --experimental-test-module-mocks --import tsx --test src/worker/services/__tests__/flashcard-quality.service.test.ts src/worker/services/__tests__/flashcard-generation.service.test.ts src/worker/services/__tests__/document-worker.service.test.ts src/worker/client/__tests__/openrouter.client.test.ts src/repositories/__tests__/document-parser.repository.test.ts src/repositories/__tests__/flashcard.repository.test.ts",
    "test:document-ingestion-v3": "node --import tsx ../test/scripts/integration/test-document-ingestion-v3.ts",
    "test:chunk-quality": "node --import tsx ../test/scripts/chunks/test-chunk-quality.ts",
    "test:question-context-packs": "node --import tsx ../test/scripts/context-packs/test-question-context-pack.ts && node --import tsx ../test/scripts/context-packs/test-question-context-pack-chunking.ts && node --import tsx ../test/scripts/context-packs/test-context-packs-organization-contract.ts",
    "test:question-spans": "node --import tsx ../test/scripts/question-spans/test-layout-content-normalizer.ts && node --import tsx ../test/scripts/question-spans/test-pedagogical-assembler.ts && node --import tsx ../test/scripts/question-spans/test-question-span-gate.ts && node --import tsx ../test/scripts/question-spans/test-question-spans-organization-contract.ts",
    "test:fluxo-docling": "node --import tsx --test ../test/fluxoteste/test-fluxo-docling.ts",
    "run:fluxo-docling": "node --import tsx ../test/fluxoteste/run-fluxo-docling.ts",
    "test:question-quality": "node --import tsx src/scripts/test-question-quality.ts",
    "test:question-candidate-persistence": "node --import tsx src/scripts/test-question-candidate-persistence.ts",
    "test:statement-evidence": "node --import tsx ../test/scripts/chunks/test-question-statement-evidence.ts",
    "test:question-dry-run": "node --import tsx src/scripts/test-question-dry-run.ts",
    "test:fluxo-offline": "node --import tsx --test ../test/fluxoteste/test-fluxo-offline.ts",
    "run:fluxo-offline": "node --import tsx ../test/fluxoteste/run-fluxo-offline.ts",
    "import:enemhub-math": "node --import tsx src/scripts/import-enemhub-math.ts",
    "import:enemhub-subject": "node --import tsx src/scripts/import-enemhub-math.ts",
    "inspect:questapi-portuguese": "node --import tsx src/scripts/inspect-questapi-portuguese-cesgranrio.ts",
    "import:questapi-portuguese-grammar": "node --import tsx src/scripts/import-questapi-portuguese-grammar.ts",
    "import:questapi-fgv-portuguese-grammar": "node --import tsx src/scripts/import-questapi-fgv-portuguese-grammar.ts",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "asaas:webhook:register": "node --import tsx src/scripts/register-asaas-webhook.ts",
    "asaas:webhook:update": "node --import tsx src/scripts/update-asaas-webhook.ts",
    "asaas:checkout:sandbox": "node --import tsx src/scripts/create-asaas-sandbox-checkout.ts",
    "asaas:webhook:test-payment-created": "node --import tsx src/scripts/test-asaas-payment-created-webhook.ts",
    "payments:backfill": "node --import tsx src/scripts/backfill-payment-subscriptions.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "bullmq": "^6.3.9",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "gpt-tokenizer": "^4.0.0",
    "ioredis": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "sharp": "^0.35.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.21.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
