generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @unique @map("user_id") @db.Uuid
  fullName              String                 @map("full_name")
  email                 String
  phone                 String?
  username              String                 @unique
  area                  String
  customArea            String?                @map("custom_area")
  bio                   String?
  pageSlug              String                 @unique @map("page_slug")
  avatarUrl             String?                @map("avatar_url")
  bannerUrl             String?                @map("banner_url")
  instagram             String?
  tiktok                String?
  youtube               String?
  role                  String                 @default("teacher")
  emailVerified         Boolean                @default(false) @map("email_verified")
  status                String                 @default("pending")
  termsAcceptedAt       DateTime               @map("terms_accepted_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  monitors              Monitor[]
  documents             MonitorDocument[]
  chunks                DocumentChunk[]
  questions             Question[]
  flashcards            Flashcard[]
  questionAiGenerations QuestionAiGeneration[]
  retrievalEvalCases    RetrievalEvalCase[]

  @@index([userId])
  @@index([status])
  @@map("teachers")
}

model Monitor {
  id                  String        @id @default(uuid()) @db.Uuid
  teacherId           String        @map("teacher_id") @db.Uuid
  name                String
  description         String?
  avatarUrl           String?       @map("avatar_url")
  detailedDescription String?       @map("detailed_description") @db.Text
  status              MonitorStatus @default(DRAFT)
  publishedAt         DateTime?     @map("published_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  teacher                    Teacher                     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjects                   MonitorSubject[]
  documents                  MonitorDocument[]
  chunks                     DocumentChunk[]
  questions                  Question[]
  flashcards                 Flashcard[]
  retrievalEvalCases         RetrievalEvalCase[]
  subscriptions              StudentSubscription[]
  purchaseItems              StudentPurchaseItem[]
  billingItems               BillingSubscriptionItem[]
  enrollments                StudentEnrollment[]
  billingSubscriptionChanges BillingSubscriptionChange[]
  dailyChallenges            DailyChallenge[]
  questionAttempts           StudentQuestionAttempt[]
  weeklySimulations          WeeklySimulation[]

  @@index([teacherId, status])
  @@map("monitors")
}

model MonitorSubject {
  id        String   @id @default(uuid()) @db.Uuid
  monitorId String   @map("monitor_id") @db.Uuid
  name      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  monitor               Monitor                @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  topics                MonitorTopic[]
  documents             MonitorDocument[]
  chunks                DocumentChunk[]
  questions             Question[]
  flashcards            Flashcard[]
  retrievalEvalCases    RetrievalEvalCase[]
  weeklySimulationItems WeeklySimulationItem[]

  @@unique([monitorId, name])
  @@unique([monitorId, position])
  @@map("monitor_subjects")
}

model MonitorTopic {
  id                       String    @id @default(uuid()) @db.Uuid
  subjectId                String    @map("subject_id") @db.Uuid
  name                     String
  definition               String?   @db.Text
  classificationGuidance   String?   @map("classification_guidance") @db.Text
  definitionOrigin         String?   @map("definition_origin")
  definitionModel          String?   @map("definition_model")
  definitionSources        Json?     @map("definition_sources")
  definitionUpdatedAt      DateTime? @map("definition_updated_at")
  aiDefinition             String?   @map("ai_definition") @db.Text
  aiClassificationGuidance String?   @map("ai_classification_guidance") @db.Text
  aiDefinitionModel        String?   @map("ai_definition_model")
  aiDefinitionSources      Json?     @map("ai_definition_sources")
  aiDefinitionUpdatedAt    DateTime? @map("ai_definition_updated_at")
  position                 Int
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  subject               MonitorSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  documents             MonitorDocument[]
  documentLinks         MonitorDocumentTopic[]
  chunkLinks            DocumentChunkTopic[]
  questions             Question[]
  flashcards            Flashcard[]
  questionTopicLinks    QuestionTopic[]
  blockTopicLinks       DocumentBlockTopic[]
  weeklySimulationItems WeeklySimulationItem[]
  questionBankSelections MonitorQuestionBankSelection[]

  @@unique([subjectId, name])
  @@unique([subjectId, position])
  @@map("monitor_topics")
}

model MonitorQuestionBankSelection {
  id             String   @id @default(uuid()) @db.Uuid
  monitorTopicId String   @map("monitor_topic_id") @db.Uuid
  subtopic       String?
  subsubtopic    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  monitorTopic MonitorTopic @relation(fields: [monitorTopicId], references: [id], onDelete: Cascade)

  @@index([monitorTopicId])
  @@map("monitor_question_bank_selections")
}

model MonitorDocument {
  id                String         @id @default(uuid()) @db.Uuid
  teacherId         String         @map("teacher_id") @db.Uuid
  monitorId         String         @map("monitor_id") @db.Uuid
  subjectId         String         @map("subject_id") @db.Uuid
  topicId           String?        @map("topic_id") @db.Uuid
  tag               DocumentTag
  originalName      String         @map("original_name")
  storagePath       String         @map("storage_path")
  mimeType          String         @map("mime_type")
  sizeBytes         Int            @map("size_bytes")
  status            DocumentStatus @default(QUEUED)
  processingVersion Int            @default(4) @map("processing_version")
  errorMessage      String?        @map("error_message")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  teacher           Teacher                    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  monitor           Monitor                    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  subject           MonitorSubject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic             MonitorTopic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicLinks        MonitorDocumentTopic[]
  chunks            DocumentChunk[]
  textExtractions   DocumentText[]
  blocks            DocumentBlock[]
  processingJobs    DocumentProcessingJob[]
  parseRuns         DocumentParseRun[]
  layoutElements    DocumentLayoutElement[]
  visualAssets      DocumentVisualAsset[]
  evidenceRelations DocumentEvidenceRelation[]
  questionSources   QuestionSource[]
  questionSpans     QuestionSpan[]

  @@index([teacherId])
  @@index([monitorId, tag, status])
  @@index([subjectId, tag])
  @@index([topicId, tag])
  @@index([processingVersion, status])
  @@map("monitor_documents")
}

model DocumentText {
  id                String              @id @default(uuid()) @db.Uuid
  documentId        String              @map("document_id") @db.Uuid
  extractionVersion String              @map("extraction_version")
  rawContent        String              @map("raw_content")
  normalizedContent String?             @map("normalized_content")
  pageCount         Int?                @map("page_count")
  quality           DocumentTextQuality @default(GOOD)
  qualityDetails    Json?               @map("quality_details")
  createdAt         DateTime            @default(now()) @map("created_at")

  document MonitorDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pages    DocumentPage[]
  blocks   DocumentBlock[]

  @@unique([documentId, extractionVersion])
  @@index([documentId, createdAt])
  @@map("document_texts")
}

model DocumentParseRun {
  id                   String    @id @default(uuid()) @db.Uuid
  documentId           String    @map("document_id") @db.Uuid
  parserName           String    @map("parser_name")
  parserVersion        String?   @map("parser_version")
  parserBackend        String?   @map("parser_backend")
  modelVersion         String?   @map("model_version")
  configurationHash    String    @map("configuration_hash")
  contentHash          String    @map("content_hash")
  layoutSchemaVersion  String    @map("layout_schema_version")
  idempotencyKey       String    @unique @map("idempotency_key")
  status               String
  qualityScore         Float?    @map("quality_score")
  artifactManifestPath String?   @map("artifact_manifest_path")
  rawOutputPath        String?   @map("raw_output_path")
  startedAt            DateTime? @map("started_at")
  finishedAt           DateTime? @map("finished_at")
  durationMs           Int?      @map("duration_ms")
  errorCode            String?   @map("error_code")
  errorMessage         String?   @map("error_message")
  metrics              Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  document MonitorDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  elements DocumentLayoutElement[]
  assets   DocumentVisualAsset[]

  @@index([documentId, createdAt])
  @@index([documentId, status])
  @@index([documentId, contentHash, configurationHash])
  @@map("document_parse_runs")
}

model DocumentLayoutElement {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  parseRunId      String   @map("parse_run_id") @db.Uuid
  externalId      String?  @map("external_id")
  pageNumber      Int      @map("page_number")
  readingOrder    Int      @map("reading_order")
  category        String
  rawText         String?  @map("raw_text")
  normalizedText  String?  @map("normalized_text")
  latex           String?
  html            String?
  bbox            Json
  columnIndex     Int?     @map("column_index")
  confidence      Float?
  parentElementId String?  @map("parent_element_id") @db.Uuid
  assetIds        Json     @map("asset_ids")
  parserMetadata  Json?    @map("parser_metadata")
  createdAt       DateTime @default(now()) @map("created_at")

  document     MonitorDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parseRun     DocumentParseRun        @relation(fields: [parseRunId], references: [id], onDelete: Cascade)
  parent       DocumentLayoutElement?  @relation("LayoutElementHierarchy", fields: [parentElementId], references: [id], onDelete: SetNull)
  children     DocumentLayoutElement[] @relation("LayoutElementHierarchy")
  visualAssets DocumentVisualAsset[]
  blockLinks   DocumentBlockElement[]

  @@unique([parseRunId, externalId])
  @@unique([parseRunId, pageNumber, readingOrder])
  @@index([documentId, pageNumber, readingOrder])
  @@index([parseRunId, category])
  @@index([parentElementId])
  @@map("document_layout_elements")
}

model DocumentVisualAsset {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  parseRunId      String   @map("parse_run_id") @db.Uuid
  layoutElementId String?  @map("layout_element_id") @db.Uuid
  pageNumber      Int      @map("page_number")
  assetType       String   @map("asset_type")
  storagePath     String   @map("storage_path")
  mimeType        String?  @map("mime_type")
  width           Int?
  height          Int?
  bbox            Json?
  checksum        String?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  document      MonitorDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parseRun      DocumentParseRun       @relation(fields: [parseRunId], references: [id], onDelete: Cascade)
  layoutElement DocumentLayoutElement? @relation(fields: [layoutElementId], references: [id], onDelete: SetNull)

  @@index([documentId, pageNumber, assetType])
  @@index([parseRunId, assetType])
  @@index([layoutElementId])
  @@map("document_visual_assets")
}

model DocumentBlockElement {
  blockId         String @map("block_id") @db.Uuid
  layoutElementId String @map("layout_element_id") @db.Uuid
  role            String
  position        Int
  confidence      Float?

  block         DocumentBlock         @relation(fields: [blockId], references: [id], onDelete: Cascade)
  layoutElement DocumentLayoutElement @relation(fields: [layoutElementId], references: [id], onDelete: Cascade)

  @@id([blockId, layoutElementId])
  @@index([layoutElementId, position])
  @@index([blockId, position])
  @@map("document_block_elements")
}

model DocumentEvidenceRelation {
  id                String   @id @default(uuid()) @db.Uuid
  documentId        String   @map("document_id") @db.Uuid
  sourceEntityType  String   @map("source_entity_type")
  sourceEntityId    String   @map("source_entity_id") @db.Uuid
  targetEntityType  String   @map("target_entity_type")
  targetEntityId    String   @map("target_entity_id") @db.Uuid
  relationType      String   @map("relation_type")
  confidence        Float?
  associationMethod String?  @map("association_method")
  reasons           Json?
  createdAt         DateTime @default(now()) @map("created_at")

  document MonitorDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, relationType])
  @@index([sourceEntityType, sourceEntityId])
  @@index([targetEntityType, targetEntityId])
  @@map("document_evidence_relations")
}

model DocumentProcessingJob {
  id                String                      @id @default(uuid()) @db.Uuid
  documentId        String                      @map("document_id") @db.Uuid
  operation         DocumentProcessingOperation
  processingVersion Int                         @map("processing_version")
  idempotencyKey    String                      @unique @map("idempotency_key")
  status            DocumentProcessingJobStatus
  attempts          Int                         @default(0)
  inputSnapshot     Json?                       @map("input_snapshot")
  outputSummary     Json?                       @map("output_summary")
  errorMessage      String?                     @map("error_message")
  startedAt         DateTime?                   @map("started_at")
  finishedAt        DateTime?                   @map("finished_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  document MonitorDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, operation, processingVersion])
  @@index([documentId, status])
  @@index([operation, status])
  @@map("document_processing_jobs")
}

model RetrievalEvalCase {
  id                     String   @id @default(uuid()) @db.Uuid
  teacherId              String   @map("teacher_id") @db.Uuid
  monitorId              String   @map("monitor_id") @db.Uuid
  subjectId              String   @map("subject_id") @db.Uuid
  question               String
  expectedBlockIds       Json     @map("expected_block_ids")
  expectedChunkIds       Json?    @map("expected_chunk_ids")
  expectedAnswerContains Json?    @map("expected_answer_contains")
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  teacher Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  monitor Monitor            @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  subject MonitorSubject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  runs    RetrievalEvalRun[]

  @@index([monitorId, subjectId, active])
  @@map("retrieval_eval_cases")
}

model RetrievalEvalRun {
  id               String   @id @default(uuid()) @db.Uuid
  caseId           String   @map("case_id") @db.Uuid
  topK             Int      @map("top_k")
  returnedBlockIds Json     @map("returned_block_ids")
  returnedChunkIds Json     @map("returned_chunk_ids")
  recallAtK        Float    @map("recall_at_k")
  reciprocalRank   Float    @map("reciprocal_rank")
  contextPrecision Float?   @map("context_precision")
  durationMs       Int      @map("duration_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  evalCase RetrievalEvalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("retrieval_eval_runs")
}

model DocumentPage {
  id                String   @id @default(uuid()) @db.Uuid
  documentTextId    String   @map("document_text_id") @db.Uuid
  pageNumber        Int      @map("page_number")
  rawContent        String   @map("raw_content")
  normalizedContent String?  @map("normalized_content")
  hasImages         Boolean? @map("has_images")
  charStart         Int?     @map("char_start")
  charEnd           Int?     @map("char_end")
  createdAt         DateTime @default(now()) @map("created_at")

  documentText DocumentText @relation(fields: [documentTextId], references: [id], onDelete: Cascade)

  @@unique([documentTextId, pageNumber])
  @@index([documentTextId, pageNumber])
  @@map("document_pages")
}

model DocumentBlock {
  id                String                       @id @default(uuid()) @db.Uuid
  documentId        String                       @map("document_id") @db.Uuid
  documentTextId    String                       @map("document_text_id") @db.Uuid
  parentBlockId     String?                      @map("parent_block_id") @db.Uuid
  blockIndex        Int                          @map("block_index")
  type              DocumentBlockType
  title             String?
  rawContent        String                       @map("raw_content")
  normalizedContent String                       @map("normalized_content")
  sectionPath       Json?                        @map("section_path")
  questionNumber    String?                      @map("question_number")
  institution       String?
  examYear          Int?                         @map("exam_year")
  pageStart         Int?                         @map("page_start")
  pageEnd           Int?                         @map("page_end")
  charStart         Int                          @map("char_start")
  charEnd           Int                          @map("char_end")
  contentHash       String                       @map("content_hash")
  detectionMethod   DocumentBlockDetectionMethod @map("detection_method")
  confidence        Float?
  isComplete        Boolean                      @default(true) @map("is_complete")
  incompleteReason  String?                      @map("incomplete_reason")
  status            DocumentBlockStatus          @default(READY)
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  document           MonitorDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentText       DocumentText           @relation(fields: [documentTextId], references: [id], onDelete: Cascade)
  parent             DocumentBlock?         @relation("DocumentBlockHierarchy", fields: [parentBlockId], references: [id], onDelete: SetNull)
  children           DocumentBlock[]        @relation("DocumentBlockHierarchy")
  chunks             DocumentChunk[]
  topicLinks         DocumentBlockTopic[]
  layoutElementLinks DocumentBlockElement[]
  questionSources    QuestionSource[]
  questionSpans      QuestionSpan[]

  @@unique([documentTextId, blockIndex])
  @@index([documentId, type, blockIndex])
  @@index([documentTextId, pageStart, pageEnd])
  @@index([documentId, questionNumber])
  @@map("document_blocks")
}

model MonitorDocumentTopic {
  documentId String   @map("document_id") @db.Uuid
  topicId    String   @map("topic_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  document MonitorDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  topic    MonitorTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([documentId, topicId])
  @@index([topicId, documentId])
  @@map("monitor_document_topics")
}

model DocumentBlockTopic {
  id                   String                   @id @default(uuid()) @db.Uuid
  blockId              String                   @map("block_id") @db.Uuid
  topicId              String?                  @map("topic_id") @db.Uuid
  classificationMethod DocumentBlockTopicMethod @map("classification_method")
  confidence           Float?
  status               DocumentBlockTopicStatus
  isPrimary            Boolean                  @default(false) @map("is_primary")
  createdAt            DateTime                 @default(now()) @map("created_at")

  block DocumentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  topic MonitorTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([blockId, topicId])
  @@index([topicId, status, blockId])
  @@index([blockId, status, isPrimary])
  @@map("document_block_topics")
}

model DocumentChunk {
  id                String                       @id @default(uuid()) @db.Uuid
  documentId        String                       @map("document_id") @db.Uuid
  teacherId         String                       @map("teacher_id") @db.Uuid
  monitorId         String                       @map("monitor_id") @db.Uuid
  subjectId         String                       @map("subject_id") @db.Uuid
  blockId           String?                      @map("block_id") @db.Uuid
  chunkIndex        Int                          @map("chunk_index")
  chunkIndexInBlock Int?                         @map("chunk_index_in_block")
  content           String
  embeddingContent  String?                      @map("embedding_content")
  contentHash       String                       @map("content_hash")
  charCount         Int                          @map("char_count")
  tokenCount        Int?                         @map("token_count")
  charStart         Int?                         @map("char_start")
  charEnd           Int?                         @map("char_end")
  pageStart         Int?                         @map("page_start")
  pageEnd           Int?                         @map("page_end")
  embeddingModel    String?                      @map("embedding_model")
  embeddingVersion  String?                      @map("embedding_version")
  embeddedAt        DateTime?                    @map("embedded_at")
  status            ChunkStatus                  @default(EMBEDDING_PENDING)
  embedding         Unsupported("vector(2048)")?
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  document          MonitorDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  teacher           Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  monitor           Monitor              @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  subject           MonitorSubject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  block             DocumentBlock?       @relation(fields: [blockId], references: [id], onDelete: SetNull)
  topicLinks        DocumentChunkTopic[]
  questionSources   QuestionSource[]
  questionSpanLinks QuestionSpanChunk[]
  flashcardSources  FlashcardSource[]

  @@unique([documentId, chunkIndex])
  @@unique([blockId, chunkIndexInBlock])
  @@index([monitorId, subjectId])
  @@index([teacherId, monitorId])
  @@index([blockId, chunkIndexInBlock])
  @@index([documentId, pageStart, pageEnd])
  @@map("document_chunks")
}

model Question {
  id                      String                       @id @default(uuid()) @db.Uuid
  teacherId               String                       @map("teacher_id") @db.Uuid
  monitorId               String                       @map("monitor_id") @db.Uuid
  subjectId               String                       @map("subject_id") @db.Uuid
  topicId                 String?                      @map("topic_id") @db.Uuid
  text                    String
  alternatives            Json
  kind                    QuestionKind                 @default(UNKNOWN)
  statementOrigin         QuestionContentOrigin        @default(SOURCE_DOCUMENT) @map("statement_origin")
  alternativesOrigin      QuestionContentOrigin?       @map("alternatives_origin")
  categoryOrigin          QuestionContentOrigin?       @map("category_origin")
  difficulty              String?
  difficultyOrigin        QuestionContentOrigin?       @map("difficulty_origin")
  statementConfidence     Float?                       @map("statement_confidence")
  alternativesConfidence  Float?                       @map("alternatives_confidence")
  correctAnswer           String?                      @map("correct_answer")
  correctAnswerOrigin     QuestionAnswerOrigin?        @map("correct_answer_origin")
  correctAnswerConfidence Float?                       @map("correct_answer_confidence")
  explanation             String?
  explanationOrigin       QuestionExplanationOrigin?   @map("explanation_origin")
  explanationConfidence   Float?                       @map("explanation_confidence")
  categoryConfidence      Float?                       @map("category_confidence")
  difficultyConfidence    Float?                       @map("difficulty_confidence")
  completenessStatus      QuestionCompletenessStatus   @default(MISSING_ANSWER) @map("completeness_status")
  needsReview             Boolean                      @default(true) @map("needs_review")
  qualityScore            Float?                       @map("quality_score")
  textHash                String                       @map("text_hash")
  sourceKey               String                       @unique @map("source_key")
  metadata                Json?
  status                  QuestionStatus               @default(PENDING_REVIEW)
  reviewedAt              DateTime?                    @map("reviewed_at")
  reviewedBy              String?                      @map("reviewed_by") @db.Uuid
  embedding               Unsupported("vector(2048)")?
  embeddingModel          String?                      @map("embedding_model")
  embeddingVersion        String?                      @map("embedding_version")
  embeddedAt              DateTime?                    @map("embedded_at")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")

  teacher               Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  monitor               Monitor                  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  subject               MonitorSubject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                 MonitorTopic?            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sources               QuestionSource[]
  topicLinks            QuestionTopic[]
  contentReports        StudentContentReport[]
  aiGenerations         QuestionAiGeneration[]
  dailyChallenges       DailyChallenge[]
  questionAttempts      StudentQuestionAttempt[]
  weeklySimulationItems WeeklySimulationItem[]

  @@unique([topicId, textHash])
  @@index([monitorId, subjectId, topicId, status])
  @@map("questions")
}

model QuestionBankItem {
  id                   String   @id @default(uuid()) @db.Uuid
  provider             String
  providerQuestionId   String   @map("provider_question_id")
  externalId           String?  @map("external_id")
  examType             String   @map("exam_type")
  examName             String   @map("exam_name")
  board                String?
  institution          String?
  examYear             Int?     @map("exam_year")
  subject              String
  topic                String
  subtopic             String?
  subsubtopic          String?
  taxonomyPath         Json     @map("taxonomy_path")
  statementHtml        String   @map("statement_html") @db.Text
  statementText        String   @map("statement_text") @db.Text
  alternatives         Json
  correctAnswer        String   @map("correct_answer")
  difficulty           String?
