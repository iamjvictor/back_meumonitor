model Student {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  fullName  String   @map("full_name")
  email     String   @unique
  phone     String?
  cpf       String?
  avatarUrl String?  @map("avatar_url")
  role      String   @default("student")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions              StudentSubscription[]
  purchases                  StudentPurchase[]
  paymentSessions            StudentPaymentSession[]
  billingCustomer            StripeCustomer?
  billingSubscriptions       BillingSubscription[]
  enrollments                StudentEnrollment[]
  billingWebhookEvents       BillingWebhookEvent[]
  billingSubscriptionChanges BillingSubscriptionChange[]
  questionAttempts           StudentQuestionAttempt[]
  challengeAttempts          DailyChallengeAttempt[]
  flashcardProgresses        StudentFlashcardProgress[]
  flashcardReviews           StudentFlashcardReviewLog[]
  contentReports             StudentContentReport[]
  weeklySimulations          WeeklySimulation[]

  @@index([userId])
  @@index([email])
  @@map("students")
}

model StudentSubscription {
  id                    String    @id @default(uuid()) @db.Uuid
  studentId             String    @map("student_id") @db.Uuid
  monitorId             String    @map("monitor_id") @db.Uuid
  purchaseId            String?   @map("purchase_id") @db.Uuid
  lastPaymentId         String?   @map("last_payment_id") @db.Uuid
  status                String    @default("active")
  amountPaid            Float     @default(0) @map("amount_paid")
  startsAt              DateTime  @default(now()) @map("starts_at")
  expiresAt             DateTime? @map("expires_at")
  gatewaySubscriptionId String?   @map("gateway_subscription_id")
  currentPeriodStart    DateTime? @map("current_period_start")
  currentPeriodEnd      DateTime? @map("current_period_end")
  cancelAtPeriodEnd     Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt           DateTime? @map("cancelled_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monitor     Monitor          @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  purchase    StudentPurchase? @relation("SubscriptionPurchase", fields: [purchaseId], references: [id], onDelete: SetNull)
  lastPayment StudentPurchase? @relation("SubscriptionLastPayment", fields: [lastPaymentId], references: [id], onDelete: SetNull)

  @@unique([studentId, monitorId])
  @@index([studentId])
  @@index([monitorId])
  @@map("student_subscriptions")
}

model StudentPurchase {
  id                String                       @id @default(uuid()) @db.Uuid
  studentId         String                       @map("student_id") @db.Uuid
  status            StudentPurchaseStatus        @default(PENDING)
  paymentMethod     StudentPurchasePaymentMethod @map("payment_method")
  currency          String                       @default("BRL")
  subtotalAmount    Int                          @map("subtotal_amount")
  discountAmount    Int                          @default(0) @map("discount_amount")
  totalAmount       Int                          @map("total_amount")
  gateway           String?
  gatewayCheckoutId String?                      @map("gateway_checkout_id")
  gatewayPaymentId  String?                      @unique @map("gateway_payment_id")
  idempotencyKey    String                       @unique @map("idempotency_key")
  failureCode       String?                      @map("failure_code")
  failureMessage    String?                      @map("failure_message")
  paidAt            DateTime?                    @map("paid_at")
  cancelledAt       DateTime?                    @map("cancelled_at")
  refundedAt        DateTime?                    @map("refunded_at")
  createdAt         DateTime                     @default(now()) @map("created_at")
