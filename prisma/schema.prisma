  environment       String          @default("SANDBOX")
  providerAccountId String?         @map("provider_account_id")
  providerEventId   String          @map("provider_event_id")
  eventType         String          @map("event_type")
  payload           Json
  state             String          @default("RECEIVED")
  attempts          Int             @default(0)
  nextAttemptAt     DateTime?       @map("next_attempt_at")
  leaseUntil        DateTime?       @map("lease_until")
  processedAt       DateTime?       @map("processed_at")
  failureMessage    String?         @map("failure_message")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  account           PaymentAccount? @relation(fields: [providerAccountId], references: [providerAccountId], onDelete: SetNull)

  @@unique([environment, providerAccountId, providerEventId])
  @@index([state, nextAttemptAt])
  @@index([eventType])
  @@map("payment_webhook_events")
}

model PaymentOutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @map("event_id")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  version       Int       @default(1)
  eventType     String    @map("event_type")
  payload       Json
  state         String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([state, nextAttemptAt])
  @@index([aggregateId, version])
  @@map("payment_outbox_events")
}

model PaymentAuditEntry {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  databaseActor String?  @map("database_actor")
  origin        String
  reason        String
  teacherId     String?  @map("teacher_id") @db.Uuid
  monitorId     String?  @map("monitor_id") @db.Uuid
  studentId     String?  @map("student_id") @db.Uuid
  before        Json?
  after         Json?
  occurredAt    DateTime @default(now()) @map("occurred_at")
  teacher       Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  monitor       Monitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  student       Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([teacherId, occurredAt])
  @@index([monitorId, occurredAt])
  @@index([studentId, occurredAt])
  @@map("payment_audit_entries")
}

model StudentAccessPaymentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @map("event_id")
  studentId   String   @map("student_id") @db.Uuid
  chargeId    String   @map("charge_id") @db.Uuid
  action      String
  processedAt DateTime @default(now()) @map("processed_at")
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, processedAt])
  @@index([chargeId])
  @@map("student_access_payment_events")
}

enum FlashcardRating {
  AGAIN
  HARD
  GOOD
  EASY
}

model StudentFlashcardProgress {
  id             String          @id @default(uuid()) @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  flashcardId    String          @map("flashcard_id") @db.Uuid
  lastRating     FlashcardRating @map("last_rating")
  repetitions    Int             @default(0)
  intervalDays   Float           @default(0) @map("interval_days")
  easeFactor     Float           @default(2.5) @map("ease_factor")
  lastReviewedAt DateTime        @default(now()) @map("last_reviewed_at")
  nextReviewAt   DateTime        @default(now()) @map("next_review_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([studentId, flashcardId])
  @@index([studentId, nextReviewAt])
  @@index([flashcardId])
  @@map("student_flashcard_progress")
}

model StudentFlashcardReviewLog {
  id           String          @id @default(uuid()) @db.Uuid
  studentId    String          @map("student_id") @db.Uuid
  flashcardId  String          @map("flashcard_id") @db.Uuid
  rating       FlashcardRating
  intervalDays Float           @map("interval_days")
  easeFactor   Float           @map("ease_factor")
  reviewedAt   DateTime        @default(now()) @map("reviewed_at")
  nextReviewAt DateTime        @map("next_review_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([studentId, reviewedAt])
  @@index([flashcardId])
  @@map("student_flashcard_review_logs")
}

enum ContentReportTargetType {
  QUESTION
  FLASHCARD
}

enum ContentReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

model StudentContentReport {
  id          String                  @id @default(uuid()) @db.Uuid
  studentId   String                  @map("student_id") @db.Uuid
  targetType  ContentReportTargetType @map("target_type")
  questionId  String?                 @map("question_id") @db.Uuid
  flashcardId String?                 @map("flashcard_id") @db.Uuid
  reason      String
  description String?                 @db.Text
  status      ContentReportStatus     @default(PENDING)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question  Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  flashcard Flashcard? @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([targetType])
  @@index([questionId])
  @@index([flashcardId])
  @@index([status])
  @@map("student_content_reports")
}
