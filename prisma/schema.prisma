  monitor  Monitor         @relation(fields: [monitorId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, monitorId])
  @@index([monitorId])
  @@map("student_purchase_items")
}

model StripeCustomer {
  id                 String                @id @default(uuid()) @db.Uuid
  studentId          String                @unique @map("student_id") @db.Uuid
  provider           String                @default("STRIPE")
  providerCustomerId String                @unique @map("provider_customer_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  student            Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscriptions      BillingSubscription[]

  @@map("stripe_customers")
}

model BillingSubscription {
  id                     String                      @id @default(uuid()) @db.Uuid
  studentId              String                      @map("student_id") @db.Uuid
  customerId             String                      @map("customer_id") @db.Uuid
  providerSubscriptionId String                      @unique @map("provider_subscription_id")
  status                 String                      @default("ACTIVE")
  billingInterval        String                      @map("billing_interval")
  currency               String                      @default("BRL")
  subtotalAmount         Int                         @map("subtotal_amount")
  discountAmount         Int                         @default(0) @map("discount_amount")
  totalAmount            Int                         @map("total_amount")
  currentPeriodStart     DateTime                    @map("current_period_start")
  currentPeriodEnd       DateTime                    @map("current_period_end")
  cancelAtPeriodEnd      Boolean                     @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?                   @map("cancelled_at")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  student                Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  customer               StripeCustomer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items                  BillingSubscriptionItem[]
  changes                BillingSubscriptionChange[]

  @@index([status])
  @@map("billing_subscriptions")
}

model BillingSubscriptionChange {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  studentId      String              @map("student_id") @db.Uuid
  type           String
  monitorId      String?             @map("monitor_id") @db.Uuid
  fromInterval   String?             @map("from_interval")
  toInterval     String?             @map("to_interval")
  amount         Int?
  operationKey   String              @unique @map("operation_key")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  subscription   BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monitor        Monitor?            @relation(fields: [monitorId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("billing_subscription_changes")
}

model BillingSubscriptionItem {
  id                         String              @id @default(uuid()) @db.Uuid
  subscriptionId             String              @map("subscription_id") @db.Uuid
  monitorId                  String              @map("monitor_id") @db.Uuid
  providerSubscriptionItemId String?             @unique @map("provider_subscription_item_id")
  status                     String              @default("ACTIVE")
  amountBeforeDiscount       Int                 @map("amount_before_discount")
  discountAmount             Int                 @default(0) @map("discount_amount")
  finalAmount                Int                 @map("final_amount")
  currentPeriodEnd           DateTime?           @map("current_period_end")
  removedAt                  DateTime?           @map("removed_at")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")
  subscription               BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  monitor                    Monitor             @relation(fields: [monitorId], references: [id], onDelete: Restrict)
  enrollments                StudentEnrollment[]

  @@unique([subscriptionId, monitorId])
  @@index([monitorId])
  @@map("billing_subscription_items")
}

model StudentEnrollment {
  id                 String                  @id @default(uuid()) @db.Uuid
  studentId          String                  @map("student_id") @db.Uuid
  monitorId          String                  @map("monitor_id") @db.Uuid
  subscriptionItemId String                  @map("subscription_item_id") @db.Uuid
  status             String                  @default("ACTIVE")
  startsAt           DateTime                @default(now()) @map("starts_at")
  endsAt             DateTime?               @map("ends_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  student            Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monitor            Monitor                 @relation(fields: [monitorId], references: [id], onDelete: Restrict)
  subscriptionItem   BillingSubscriptionItem @relation(fields: [subscriptionItemId], references: [id], onDelete: Restrict)

  @@unique([studentId, monitorId])
  @@index([status])
  @@map("student_enrollments")
}

model BillingWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  status          String    @default("RECEIVED")
  processedAt     DateTime? @map("processed_at")
  failureMessage  String?   @map("failure_message")
  studentId       String?   @map("student_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  student         Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status])
  @@map("billing_webhook_events")
}

enum FlashcardRating {
  AGAIN
  HARD
  GOOD
  EASY
}

model StudentFlashcardProgress {
  id             String          @id @default(uuid()) @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  flashcardId    String          @map("flashcard_id") @db.Uuid
  lastRating     FlashcardRating @map("last_rating")
  repetitions    Int             @default(0)
  intervalDays   Float           @default(0) @map("interval_days")
  easeFactor     Float           @default(2.5) @map("ease_factor")
  lastReviewedAt DateTime        @default(now()) @map("last_reviewed_at")
  nextReviewAt   DateTime        @default(now()) @map("next_review_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([studentId, flashcardId])
  @@index([studentId, nextReviewAt])
  @@index([flashcardId])
  @@map("student_flashcard_progress")
}

model StudentFlashcardReviewLog {
  id           String          @id @default(uuid()) @db.Uuid
  studentId    String          @map("student_id") @db.Uuid
  flashcardId  String          @map("flashcard_id") @db.Uuid
  rating       FlashcardRating
  intervalDays Float           @map("interval_days")
  easeFactor   Float           @map("ease_factor")
  reviewedAt   DateTime        @default(now()) @map("reviewed_at")
  nextReviewAt DateTime        @map("next_review_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([studentId, reviewedAt])
  @@index([flashcardId])
  @@map("student_flashcard_review_logs")
}

enum ContentReportTargetType {
  QUESTION
  FLASHCARD
}

enum ContentReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

model StudentContentReport {
  id          String                  @id @default(uuid()) @db.Uuid
  studentId   String                  @map("student_id") @db.Uuid
  targetType  ContentReportTargetType @map("target_type")
  questionId  String?                 @map("question_id") @db.Uuid
  flashcardId String?                 @map("flashcard_id") @db.Uuid
  reason      String
  description String?                 @db.Text
  status      ContentReportStatus     @default(PENDING)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question  Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  flashcard Flashcard? @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([targetType])
  @@index([questionId])
  @@index([flashcardId])
  @@index([status])
  @@map("student_content_reports")
}
